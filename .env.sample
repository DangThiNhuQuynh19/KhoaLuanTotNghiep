# Sample .env file for local development/testing
# Copy this file to .env and update values as needed

APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hanhphuc
DB_USERNAME=root
DB_PASSWORD=

# WebSocket
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8080
WEBSOCKET_PROTOCOL=ws

# Upload (use forward slashes even on Windows)
UPLOAD_DIR=./uploads/
UPLOAD_URL=/uploads/

# Encryption (change in production!)
ENCRYPTION_KEY=test-key-for-development-only
ENCRYPTION_IV_SEED=test-iv-seed-development

# Polling
POLLING_INTERVAL=3000
