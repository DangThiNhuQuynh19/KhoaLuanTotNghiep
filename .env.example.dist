# Application Configuration
# Copy this file to .env and configure your values
# ================================================

# Application Settings
APP_DEBUG=false
APP_URL=http://localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hanhphuc
DB_USERNAME=root
DB_PASSWORD=

# WebSocket Server Configuration
# Set WEBSOCKET_ENABLED=false to use AJAX polling fallback
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8080
# For production with SSL, use wss:// protocol
# WEBSOCKET_PROTOCOL=wss
WEBSOCKET_PROTOCOL=ws

# Upload Directory Configuration
# Absolute path to uploads directory on server
UPLOAD_DIR=/var/www/html/uploads/
# URL path to access uploaded files
UPLOAD_URL=/uploads/

# Encryption Keys (change these in production!)
ENCRYPTION_KEY=mySuperSecretKey123!
ENCRYPTION_IV_SEED=myInitVector

# Session Configuration
SESSION_LIFETIME=120

# Pusher Configuration (optional - for real-time broadcasting via Pusher)
# If not configured, the app will use WebSocket server or AJAX polling
PUSHER_ENABLED=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# AJAX Polling Configuration (fallback when WebSocket unavailable)
# Polling interval in milliseconds
POLLING_INTERVAL=3000
