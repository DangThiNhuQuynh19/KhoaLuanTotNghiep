@startuml KhoaLuanTotNghiep_ClassDiagram

' Định nghĩa các lớp chính trong hệ thống quản lý bệnh viện

' ============ Lớp kết nối database ============
class clsKetNoi {
  + moKetNoi(): mysqli
  + dongKetNoi(con: mysqli): void
}

' ============ Lớp Model chính ============

class mTaiKhoan {
  - conn: mysqli
  + __construct()
  + dangkytk(mabenhnhan, email, hoten, ngaysinh, sdt, cccd, ...): bool|string
  + select_01_taikhoan(tentk, matkhau): result
  + taikhoanbacsi(tentk): result
  + taikhoanbenhnhan(id): result
  + select_taikhoan(): result
}

class mNguoiDung {
  + manguoidung: string
  + hoten: string
  + ngaysinh: date
  + gioitinh: string
  + cccd: string
  + cccd_matruoc: string
  + cccd_matsau: string
  + dantoc: string
  + sdt: string
  + emailcanhan: string
  + sonha: string
  + maxaphuong: int
  + email: string
}

class mBenhNhan {
  - conn: mysqli
  + __construct()
  + getBenhNhanByTenTK(email): result
  + getBenhNhanByID(id): result
  + getBenhNhan(): result
  + capnhatbenhnhan(mabenhnhan, hoten, ...): bool
  + insertbenhnhan(mabenhnhan, email, ...): bool|string
  + deletebenhnhan(id): result
  + select_benhnhan_mabacsi(mabacsi): result
  + select_benhnhan_machuyengia(machuyengia): result
  + select_benhnhan_id(id): result
  + select_benhnhan_homnay(mabacsi): result
  + select_benhnhan_mabenhnhan(mabenhnhan): result
  + timkiem_benhnhan_tukhoa(tukhoa, mabacsi): result
  + update_vitien_id(id, tongtien): result
}

class mBacSi {
  + mabacsi: string
  + motabs: string
  + gioithieubs: string
  + ngaybatdau: date
  + ngayketthuc: date
  + imgbs: string
  + giakham: int
  + machuyenkhoa: int
  + capbac: string
  + dsbacsi(): result
  + dsbacsi1(): result
  + chitietbacsi(id): result
  + bacsitheoten(name): result
  + bacsitheokhoa(id): result
  + xembacsitheotentk(tentk): result
  + updateBacSi(mabacsi, data): bool
  + luuNguoiDungVaBacSi(data, files): bool
  + xemlichlambacsi(tentk): result
}

class mChuyenGia {
  + machuyengia: string
  + motacg: string
  + gioithieucg: string
  + ngaybatdau: date
  + ngayketthuc: date
  + imgcg: string
  + giatuvan: int
  + malinhvuc: int
  + capbac: string
  + matrangthai: int
  + dschuyengia(): result
  + dschuyengia1(): result
  + chitietchuyengia(id): result
  + chuyengiatheotenandlinhvuc(name, id): result
  + chuyengiatheoten(name): result
  + chuyengiatheolinhvuc(id): result
  + xemchuyengiatheotentk(tentk): result
  + updateChuyenGia(machuyengia, data): bool
  + xemlichlamchuyengia(tentk): result
}

class mChuyenKhoa {
  + machuyenkhoa: int
  + tenchuyenkhoa: string
  + motachuyenkhoa: string
  + imgchuyenkhoa: string
}

class mLinhVuc {
  + malinhvuc: int
  + tenlinhvuc: string
  + motalinhvuc: string
  + imglinhvuc: string
}

class mPhieuKhamBenh {
  + maphieukhambenh: string
  + ngaykham: date
  + makhunggiokb: int
  + mabacsi: string
  + mabenhnhan: string
  + matrangthai: int
  + insertphieukham(...): result
  + phieukhambenhcuabn(idbn): result
  + kiemTraTrungLich(mabenhnhan, ngaykham, makhunggiokhambenh): result
  + phieukhambenhcuataikhoan(tentk, status, ngay): result
  + huyPhieuKhamBenh(maphieukb, tk, tongtien): result
  + updatePhieuKhamBenh(maphieukb): result
  + select_lichkhamonl_mabacsi(mabacsi): result
  + select_lichkhamoff_mabacsi(mabacsi): result
  + select_phieukhamonl_homnay(manguoidung, ngay): result
  + select_phieukhamoff_homnay(manguoidung, ngay): result
  + timkiem_phieukhamonl(tukhoa, trangthai, ngay, mabacsi): result
  + timkiem_phieukhamoff(tukhoa, trangthai, ngay, mabacsi): result
  + updateTrangThaiPhieu(maphieukhambenh, trangthai): result
}

class mHoSoBenhAnDienTu {
  + mahoso: int
  + mabenhnhan: string
  + ngaytao: date
  + ngaycapnhat: date
  + gethosotheotentk(tentk): result
  + getchitiethosotheotentk(id): result
  + getchitiethosotheohoso(id): result
  + getdonthuoctheohoso(id): result
  + getxetnghiemtheohoso(id): result
  + select_hsba_mabenhnhan(mabenhnhan): result
  + select_hsba_mabenhnhan1(mabenhnhan): result
  + select_hsba(): result
  + insert_hosobenhandientu_mabenhnhan(mabenhnhan): result
  + select_hsba_new(mabenhnhan): result
  + select_benhnhan_mahoso(mahoso): result
  + select_hoso_mahoso(mahoso): result
  + select_hoso_machuyenkhoa(mabenhnhan, machuyenkhoa): result
  + select_hoso_malinhvuc(mabenhnhan, machuyenkhoa): result
}

class mChiTietHoSo {
  + machitiethoso: int
  + mahoso: int
  + mabacsi: string
  + ngaykham: date
  + chandoan: string
  + trieuchungbandau: string
  + huongdieutri: string
  + ketluan: string
  + madonthuoc: int
}

class mDonThuoc {
  + madonthuoc: int
  + ngayke: date
  + ghichu: string
}

class mChiTietDonThuoc {
  + machitietdonthuoc: int
  + madonthuoc: int
  + mathuoc: int
  + soluong: int
