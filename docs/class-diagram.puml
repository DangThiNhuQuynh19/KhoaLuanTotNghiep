  + cachdung: string
}

class mThuoc {
  + mathuoc: int
  + tenthuoc: string
  + donvitinh: string
  + dongia: int
  + mota: string
}

class mLichHen {
  + lichhen(ngay, loaikham, hinhthuclamviec, tenbenhnhan): array
