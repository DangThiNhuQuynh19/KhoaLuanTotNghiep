' Quan hệ giữa các Models
mTaiKhoan "1" -- "1" mNguoiDung : manages
mBacSi "1" -- "1" mChuyenKhoa : belongs to
mChuyenGia "1" -- "1" mLinhVuc : belongs to
mNguoiDung "1" -- "1" mXaPhuong : lives in
mXaPhuong "n" -- "1" mTinhThanhPho : belongs to

mPhieuKhamBenh "n" -- "1" mBenhNhan : has
mPhieuKhamBenh "n" -- "1" mBacSi : assigned to
mPhieuKhamBenh "n" -- "1" mChuyenGia : assigned to
mPhieuKhamBenh "1" -- "1" mKhungGioKhamBenh : scheduled at
mPhieuKhamBenh "1" -- "1" mTrangThai : has

mHoSoBenhAnDienTu "n" -- "1" mBenhNhan : belongs to
mHoSoBenhAnDienTu "1" -- "n" mChiTietHoSo : contains
mChiTietHoSo "1" -- "1" mBacSi : diagnosed by
mChiTietHoSo "1" -- "1" mChuyenGia : diagnosed by
mChiTietHoSo "1" -- "0..1" mDonThuoc : has

mDonThuoc "1" -- "n" mChiTietDonThuoc : contains
mChiTietDonThuoc "n" -- "1" mThuoc : uses

mLichXetNghiem "n" -- "1" mHoSoBenhAnDienTu : belongs to
mLichXetNghiem "1" -- "1" mLoaiXetNghiem : type of
mLichXetNghiem "1" -- "1" mKetQuaXetNghiem : has result
mLichXetNghiem "1" -- "1" mTrangThai : has
mLichXetNghiem "1" -- "1" mKhungGioXetNghiem : scheduled at

mLichLamViec "n" -- "1" mBacSi : scheduled for
mLichLamViec "n" -- "1" mChuyenGia : scheduled for
mLichLamViec "n" -- "1" mCaLamViec : at shift
mLichLamViec "n" -- "0..1" mPhong : at room

mKhungGioKhamBenh "n" -- "1" mCaLamViec : belongs to
mKhungGioXetNghiem "n" -- "1" mCaLamViec : belongs to

mTaiKhoan "1" -- "1" mVaiTro : has role
mTaiKhoan "1" -- "1" mTrangThai : has status

mLichKham "n" -- "1" mBacSi : for doctor
mLichKham "n" -- "1" mChuyenGia : for expert
mLichKham "n" -- "1" mBenhNhan : for patient

mChiTietBacSi "1" -- "1" mBacSi : details of
mChiTietChuyenKhoa "1" -- "1" mChuyenKhoa : details of

mEmailThanhToan "n" -- "1" mPhieuKhamBenh : payment for

