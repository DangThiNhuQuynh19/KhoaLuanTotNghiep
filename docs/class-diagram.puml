  + gioketthuc: time
}

class mKhungGioKhamBenh {
  + makhunggiokb: int
  + macalamviec: int
  + giobatdau: time
  + gioketthuc: time
}

class mLichXetNghiem {
  + malichxetnghiem: int
  + mahoso: int
  + ngayxetnghiem: date
  + makhunggio: int
  + maloaixetnghiem: int
  + matrangthai: int
}

class mLoaiXetNghiem {
  + maloaixetnghiem: int
  + tenloaixetnghiem: string
  + dongia: int
  + mota: string
}

class mKetQuaXetNghiem {
  + maketqua: int
  + malichxetnghiem: int
  + ketqua: string
  + ghichu: string
  + ngaytraketqua: date
}

class mTrangThai {
  + matrangthai: int
  + tentrangthai: string
}

class mVaiTro {
  + mavaitro: int
  + tenvaitro: string
}

class mTinhThanhPho {
  + matinhthanhpho: int
  + tentinhthanhpho: string
}

class mXaPhuong {
  + maxaphuong: int
  + tenxaphuong: string
  + matinhthanhpho: int
}

class mPhong {
  + maphong: int
  + tentoa: string
  + tang: int
  + sophong: int
}

' ============ Lớp Controller ============

class cBenhNhan {
  + xulyBenhNhan(): void
}

class cBacSi {
  + xulyBacSi(): void
}

class cChuyenGia {
  + xulyChuyenGia(): void
}

class cTaiKhoan {
  + xulyTaiKhoan(): void
}

class cPhieuKhamBenh {
  + xulyPhieuKhamBenh(): void
}

class cHoSoBenhAnDienTu {
  + xulyHoSoBenhAn(): void
}

class cLichHen {
  + xulyLichHen(): void
}

' ============ Quan hệ giữa các lớp ============

' Kế thừa từ Người dùng
mNguoiDung <|-- mBenhNhan : extends
mNguoiDung <|-- mBacSi : extends
mNguoiDung <|-- mChuyenGia : extends

' Sử dụng kết nối database
mTaiKhoan --> clsKetNoi : uses
mBenhNhan --> clsKetNoi : uses
mBacSi --> clsKetNoi : uses
mChuyenGia --> clsKetNoi : uses
mPhieuKhamBenh --> clsKetNoi : uses
mHoSoBenhAnDienTu --> clsKetNoi : uses
mLichHen --> clsKetNoi : uses

' Quan hệ giữa các Models
mTaiKhoan "1" -- "1" mNguoiDung : manages
mBacSi "1" -- "1" mChuyenKhoa : belongs to
mChuyenGia "1" -- "1" mLinhVuc : belongs to
mNguoiDung "1" -- "1" mXaPhuong : lives in
mXaPhuong "n" -- "1" mTinhThanhPho : belongs to

mPhieuKhamBenh "n" -- "1" mBenhNhan : has
mPhieuKhamBenh "n" -- "1" mBacSi : assigned to
mPhieuKhamBenh "n" -- "1" mChuyenGia : assigned to
mPhieuKhamBenh "1" -- "1" mKhungGioKhamBenh : scheduled at
mPhieuKhamBenh "1" -- "1" mTrangThai : has

mHoSoBenhAnDienTu "n" -- "1" mBenhNhan : belongs to
mHoSoBenhAnDienTu "1" -- "n" mChiTietHoSo : contains
mChiTietHoSo "1" -- "1" mBacSi : diagnosed by
mChiTietHoSo "1" -- "1" mChuyenGia : diagnosed by
mChiTietHoSo "1" -- "0..1" mDonThuoc : has

mDonThuoc "1" -- "n" mChiTietDonThuoc : contains
mChiTietDonThuoc "n" -- "1" mThuoc : uses

mLichXetNghiem "n" -- "1" mHoSoBenhAnDienTu : belongs to
mLichXetNghiem "1" -- "1" mLoaiXetNghiem : type of
mLichXetNghiem "1" -- "1" mKetQuaXetNghiem : has result
mLichXetNghiem "1" -- "1" mTrangThai : has

mLichLamViec "n" -- "1" mBacSi : scheduled for
mLichLamViec "n" -- "1" mChuyenGia : scheduled for
mLichLamViec "n" -- "1" mCaLamViec : at shift
mLichLamViec "n" -- "0..1" mPhong : at room

mKhungGioKhamBenh "n" -- "1" mCaLamViec : belongs to

mTaiKhoan "1" -- "1" mVaiTro : has role
mTaiKhoan "1" -- "1" mTrangThai : has status

' Controllers sử dụng Models
cBenhNhan --> mBenhNhan : uses
cBacSi --> mBacSi : uses
cChuyenGia --> mChuyenGia : uses
cTaiKhoan --> mTaiKhoan : uses
cPhieuKhamBenh --> mPhieuKhamBenh : uses
cHoSoBenhAnDienTu --> mHoSoBenhAnDienTu : uses
cLichHen --> mLichHen : uses

@enduml
