mLichXetNghiem "n" -- "1" mHoSoBenhAnDienTu : thuộc về
mLichXetNghiem "1" -- "1" mLoaiXetNghiem : loại
mLichXetNghiem "1" -- "1" mKetQuaXetNghiem : có kết quả
mLichXetNghiem "1" -- "1" mTrangThai : có trạng thái
mLichXetNghiem "1" -- "1" mKhungGioXetNghiem : được xếp lịch tại

mLichLamViec "n" -- "1" mBacSi : được xếp lịch cho
mLichLamViec "n" -- "1" mChuyenGia : được xếp lịch cho
mLichLamViec "n" -- "1" mCaLamViec : tại ca
mLichLamViec "n" -- "0..1" mPhong : tại phòng

mKhungGioKhamBenh "n" -- "1" mCaLamViec : thuộc về
mKhungGioXetNghiem "n" -- "1" mCaLamViec : thuộc về

mTaiKhoan "1" -- "1" mVaiTro : có vai trò
mTaiKhoan "1" -- "1" mTrangThai : có trạng thái

mLichKham "n" -- "1" mBacSi : cho bác sĩ
mLichKham "n" -- "1" mChuyenGia : cho chuyên gia
mLichKham "n" -- "1" mBenhNhan : cho bệnh nhân

mChiTietBacSi "1" -- "1" mBacSi : chi tiết của
mChiTietChuyenKhoa "1" -- "1" mChuyenKhoa : chi tiết của

mEmailThanhToan "n" -- "1" mPhieuKhamBenh : thanh toán cho

