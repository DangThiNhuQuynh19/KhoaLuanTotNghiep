# WebSocket Configuration (Optional)
# If not set, the system will auto-detect based on the current environment

# WebSocket Host (optional)
# Leave empty to use current HTTP_HOST
# Example: WEBSOCKET_HOST=hanhphuc.site
# WEBSOCKET_HOST=

# WebSocket Port (default: 8080)
# WEBSOCKET_PORT=8080

# WebSocket Path (optional, for reverse proxy setup)
# If you're using Nginx/Apache reverse proxy, set this to the proxy path
# Example: WEBSOCKET_PATH=/ws
# WEBSOCKET_PATH=
